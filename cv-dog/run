#!/bin/sh
# Runs the cv-dog demo (after ./install): starts the flwrs server, enables
# the scene, serves the page, and prints its address. Ctrl+C disables the
# scene and stops everything.
#
#   ./run                 the page at http://127.0.0.1:8078/
#   ./run --open          and open it in the browser
#   ./run --video <file>  an MJPEG recording instead of the camera (looped)
#
# run.ps1 is the Windows version: keep the two in step.
set -eu

DEMO=$(cd "$(dirname "$0")" && pwd)
PAGE_PORT=8078
OPEN=
VIDEO=

die() { printf 'run: %s\n' "$*" >&2; exit 1; }
while [ $# -gt 0 ]; do
  case $1 in
    --open) OPEN=1; shift ;;
    --video) [ $# -ge 2 ] || die "--video needs a file"; VIDEO=$(cd "$(dirname "$2")" && pwd)/$(basename "$2"); shift 2 ;;
    -h|--help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;;
    *) die "unknown option $1 (see --help)" ;;
  esac
done

cd "$DEMO"
[ -x bin/flwrs-app ] || die "not installed: run ./install first"
command -v python3 >/dev/null 2>&1 || die "python3 is needed"

mkdir -p .data
# The server and the page server in process groups of their own (job
# control), so a Ctrl+C reaches only this script, which disables the scene
# before it stops the server.
set -m
./bin/flwrs-app --config scene/config.toml >>.data/server.log 2>&1 &
server=$!
page=
stop() {
  trap - EXIT INT TERM
  printf '\nStopping…\n'
  python3 scene/setup.py disable 2>/dev/null || true
  [ -n "$page" ] && kill "$page" 2>/dev/null || true
  kill -TERM "$server" 2>/dev/null || true
  wait "$server" 2>/dev/null || true
}
trap stop EXIT INT TERM

python3 scene/setup.py wait 60
if [ -n "$VIDEO" ]; then
  python3 scene/setup.py input-video "$VIDEO"
else
  python3 scene/setup.py input-camera
fi
python3 scene/setup.py enable
python3 -m http.server "$PAGE_PORT" --bind 127.0.0.1 --directory "$DEMO" >/dev/null 2>&1 &
page=$!
set +m

url="http://127.0.0.1:$PAGE_PORT/"
printf 'The dog: %s\nflwrs:   http://127.0.0.1:8077/ (the server, its scene and logs)\nCtrl+C stops.\n' "$url"
if [ -n "$OPEN" ]; then
  (command -v open >/dev/null 2>&1 && open "$url") || (command -v xdg-open >/dev/null 2>&1 && xdg-open "$url") || true
fi
wait "$server"
